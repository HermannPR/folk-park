{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folkpark.audio/schemas/preset-v2.json",
  "title": "folk park native preset",
  "description": "Frozen Release 0.1 native preset contract. Unknown top-level fields are preserved as inert data by the native codec.",
  "type": "object",
  "required": [
    "schemaVersion", "product", "metadata", "parameters", "modulationRoutes",
    "effects", "assets", "migrationProvenance"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "product": {
      "type": "object",
      "required": ["identifier", "name", "version"],
      "properties": {
        "identifier": { "const": "com.folkpark.audio.folkpark" },
        "name": { "const": "folk park" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
          "maxLength": 32
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["id", "name", "author", "tags", "genre", "emotion", "description", "favorite"],
      "properties": {
        "id": { "type": "string", "format": "uuid", "maxLength": 36 },
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "author": { "type": "string", "maxLength": 96 },
        "tags": {
          "type": "array", "maxItems": 24, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 48 }
        },
        "genre": { "type": "string", "maxLength": 64 },
        "emotion": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 1024 },
        "favorite": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "minProperties": 73,
      "maxProperties": 73,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$" },
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "modulationRoutes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["source", "destination", "amount", "curve", "enabled"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 32 },
          "destination": { "type": "string", "minLength": 1, "maxLength": 64 },
          "amount": { "type": "number", "minimum": -1, "maximum": 1 },
          "curve": { "enum": ["linear", "concave", "convex"] },
          "enabled": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "effects": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "parameters"],
        "properties": {
          "id": { "enum": ["distortion", "chorus", "delay", "reverb", "compressor", "eq"] },
          "parameters": {
            "type": "object",
            "minProperties": 4,
            "maxProperties": 7,
            "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$" },
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["kind", "slot", "sha256", "relativePath", "byteSize", "recovery"],
        "properties": {
          "kind": { "enum": ["wavetableSource", "wavetableFrames", "sample"] },
          "slot": { "enum": ["oscillatorA", "oscillatorB", "sample"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "relativePath": {
            "type": "string",
            "pattern": "^assets/[0-9a-f]{64}\\.(wav|fkwt)$",
            "maxLength": 82
          },
          "byteSize": { "type": "integer", "minimum": 1, "maximum": 67108864 },
          "recovery": {
            "type": "object",
            "required": ["displayName", "originalSha256"],
            "properties": {
              "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
              "originalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "preview": {
      "type": ["object", "null"],
      "required": ["kind", "sha256", "durationSeconds"],
      "properties": {
        "kind": { "const": "audio/wav" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "durationSeconds": { "type": "number", "minimum": 0, "maximum": 900 }
      },
      "additionalProperties": false
    },
    "migrationProvenance": {
      "type": "object",
      "required": ["originalSchemaVersion", "steps"],
      "properties": {
        "originalSchemaVersion": { "type": "integer", "minimum": 1, "maximum": 2 },
        "steps": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
