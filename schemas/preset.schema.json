{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folkpark.audio/schemas/preset-v1.json",
  "title": "folk park native preset",
  "type": "object",
  "required": ["schemaVersion", "productVersion", "metadata", "parameters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productVersion": { "type": "string" },
    "metadata": { "type": "object" },
    "parameters": { "type": "object" },
    "modulationRoutes": { "type": "array", "maxItems": 32 },
    "assets": { "type": "array", "maxItems": 128 }
  },
  "additionalProperties": true
}
