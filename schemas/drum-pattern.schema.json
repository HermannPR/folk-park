{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folkpark.audio/schemas/drum-pattern-v1.json",
  "title": "folk park DrumPattern",
  "type": "object",
  "required": [
    "schemaVersion", "id", "requestId", "ppq", "lengthTicks", "tempoBpm",
    "timeSignature", "seed", "genre", "kitId", "generatorVersion",
    "parentPatternId", "createdUnixMs", "events"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "format": "uuid", "maxLength": 36 },
    "requestId": { "type": "string", "format": "uuid", "maxLength": 36 },
    "ppq": { "type": "integer", "minimum": 24, "maximum": 9600 },
    "lengthTicks": { "type": "integer", "minimum": 1, "maximum": 983040 },
    "tempoBpm": { "type": "number", "minimum": 20, "maximum": 400 },
    "timeSignature": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 2, "maximum": 12 },
        "denominator": { "enum": [2, 4, 8, 16] }
      },
      "additionalProperties": false
    },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "genre": { "enum": ["indie_rock", "eurodance", "techno", "funk", "jazz"] },
    "kitId": { "const": "synth_core_v1" },
    "generatorVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "parentPatternId": { "type": ["string", "null"], "maxLength": 36 },
    "createdUnixMs": { "type": "integer", "minimum": 0 },
    "events": {
      "type": "array", "maxItems": 8192,
      "items": {
        "type": "object",
        "required": ["startTick", "durationTicks", "lane", "velocity", "probability", "articulation"],
        "properties": {
          "startTick": { "type": "integer", "minimum": 0 },
          "durationTicks": { "type": "integer", "minimum": 1 },
          "lane": { "enum": ["kick", "snare", "closed_hat", "open_hat", "percussion"] },
          "velocity": { "type": "integer", "minimum": 1, "maximum": 127 },
          "probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "articulation": { "enum": ["normal", "accent", "ghost", "flam"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
