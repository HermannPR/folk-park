{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folkpark.audio/schemas/parameter-proposal-v1.json",
  "title": "folk park ParameterProposal v1",
  "type": "object",
  "required": [
    "schemaVersion", "proposalId", "requestId", "changes", "explanation",
    "assumptions", "confidence", "requiresExplicitAcceptance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "proposalId": { "type": "string", "format": "uuid", "maxLength": 36 },
    "requestId": { "type": "string", "format": "uuid", "maxLength": 36 },
    "changes": {
      "type": "array", "minItems": 1, "maxItems": 73,
      "items": {
        "type": "object",
        "required": ["parameterId", "currentNormalized", "proposedNormalized", "reason"],
        "properties": {
          "parameterId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "currentNormalized": { "type": "number", "minimum": 0, "maximum": 1 },
          "proposedNormalized": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string", "maxLength": 256 }
        },
        "additionalProperties": false
      }
    },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "assumptions": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 256 } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "requiresExplicitAcceptance": { "const": true }
  },
  "additionalProperties": false
}
