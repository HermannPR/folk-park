{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folkpark.audio/schemas/music-intent-v1.json",
  "title": "folk park MusicIntent",
  "type": "object",
  "required": ["schemaVersion", "requestId", "seed", "key", "scale", "tempoBpm", "lengthBars", "parts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "format": "uuid" },
    "seed": { "type": "integer", "minimum": 0 },
    "key": { "type": "string" },
    "scale": { "type": "string" },
    "tempoBpm": { "type": "number", "minimum": 20, "maximum": 400 },
    "lengthBars": { "type": "integer", "minimum": 1, "maximum": 64 },
    "parts": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["chords", "melody", "bass", "arp"] } }
  },
  "additionalProperties": false
}
