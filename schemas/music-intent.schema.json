{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folkpark.audio/schemas/music-intent-v1.json",
  "title": "folk park MusicIntent",
  "type": "object",
  "required": [
    "schemaVersion", "requestId", "seed", "key", "scale", "tempoBpm",
    "timeSignature", "lengthBars", "parts", "genreProfile", "emotion",
    "density", "rhythmComplexity", "tension", "humanization",
    "repetition", "variation", "arp", "constraints"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "format": "uuid", "maxLength": 36 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "key": { "enum": ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"] },
    "scale": { "enum": ["major", "natural_minor", "harmonic_minor", "dorian", "mixolydian", "pentatonic_major", "pentatonic_minor"] },
    "tempoBpm": { "type": "number", "minimum": 20, "maximum": 400 },
    "timeSignature": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 2, "maximum": 12 },
        "denominator": { "enum": [2, 4, 8, 16] }
      },
      "additionalProperties": false
    },
    "lengthBars": { "type": "integer", "minimum": 1, "maximum": 64 },
    "parts": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": { "enum": ["chords", "melody", "bass", "arp"] }
    },
    "genreProfile": { "enum": ["generic", "melodic_techno", "house", "ambient", "synthwave", "cinematic"] },
    "emotion": { "enum": ["neutral", "dark", "bright", "tense", "hopeful", "dreamy"] },
    "density": { "type": "number", "minimum": 0, "maximum": 1 },
    "rhythmComplexity": { "type": "number", "minimum": 0, "maximum": 1 },
    "tension": { "type": "number", "minimum": 0, "maximum": 1 },
    "humanization": { "type": "number", "minimum": 0, "maximum": 1 },
    "repetition": { "type": "number", "minimum": 0, "maximum": 1 },
    "variation": { "type": "number", "minimum": 0, "maximum": 1 },
    "arp": {
      "type": "object",
      "required": ["mode", "rateDivision", "gate", "octaveSpan", "latch", "sync"],
      "properties": {
        "mode": { "enum": ["up", "down", "up_down", "random_seeded", "chord_order"] },
        "rateDivision": { "enum": ["1/4", "1/8", "1/16", "1/32"] },
        "gate": { "type": "number", "minimum": 0.05, "maximum": 1 },
        "octaveSpan": { "type": "integer", "minimum": 1, "maximum": 4 },
        "latch": { "type": "boolean" },
        "sync": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "required": ["lowestMidiNote", "highestMidiNote", "maxPolyphony", "maximumEvents"],
      "properties": {
        "lowestMidiNote": { "type": "integer", "minimum": 0, "maximum": 127 },
        "highestMidiNote": { "type": "integer", "minimum": 0, "maximum": 127 },
        "maxPolyphony": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maximumEvents": { "type": "integer", "minimum": 1, "maximum": 16384 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
