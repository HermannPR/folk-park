{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folkpark.audio/schemas/sound-intent-v1.json",
  "title": "folk park SoundIntent",
  "type": "object",
  "required": ["schemaVersion", "requestId", "seed", "entryMode", "answers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "format": "uuid", "maxLength": 36 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "entryMode": { "enum": ["describe", "guided", "manual"] },
    "answers": {
      "type": "object",
      "properties": {
        "musicalRole": { "type": "string", "maxLength": 128 },
        "timbre": { "type": "string", "maxLength": 256 },
        "articulation": { "type": "string", "maxLength": 128 },
        "movement": { "type": "string", "maxLength": 128 },
        "space": { "type": "string", "maxLength": 128 },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "genreContext": { "type": "string", "maxLength": 128 },
        "referenceDescription": { "type": "string", "maxLength": 512 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
