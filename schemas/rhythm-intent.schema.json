{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folkpark.audio/schemas/rhythm-intent-v1.json",
  "title": "folk park RhythmIntent",
  "type": "object",
  "required": [
    "schemaVersion", "requestId", "seed", "tempoBpm", "timeSignature",
    "lengthBars", "genre", "density", "complexity", "swing",
    "humanization", "fillAmount", "lanes", "maximumEvents"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "format": "uuid", "maxLength": 36 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "tempoBpm": { "type": "number", "minimum": 20, "maximum": 400 },
    "timeSignature": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 2, "maximum": 12 },
        "denominator": { "enum": [2, 4, 8, 16] }
      },
      "additionalProperties": false
    },
    "lengthBars": { "type": "integer", "minimum": 1, "maximum": 64 },
    "genre": { "enum": ["indie_rock", "eurodance", "techno", "funk", "jazz"] },
    "density": { "type": "number", "minimum": 0, "maximum": 1 },
    "complexity": { "type": "number", "minimum": 0, "maximum": 1 },
    "swing": { "type": "number", "minimum": 0, "maximum": 0.75 },
    "humanization": { "type": "number", "minimum": 0, "maximum": 1 },
    "fillAmount": { "type": "number", "minimum": 0, "maximum": 1 },
    "lanes": {
      "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
      "items": { "enum": ["kick", "snare", "closed_hat", "open_hat", "percussion"] }
    },
    "maximumEvents": { "type": "integer", "minimum": 1, "maximum": 8192 }
  },
  "additionalProperties": false
}
