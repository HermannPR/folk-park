{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folkpark.audio/schemas/generated-clip-v1.json",
  "title": "folk park GeneratedClip",
  "type": "object",
  "required": ["schemaVersion", "id", "part", "ppq", "seed", "generatorVersion", "events"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "part": { "enum": ["chords", "melody", "bass", "arp"] },
    "ppq": { "type": "integer", "minimum": 24, "maximum": 9600 },
    "seed": { "type": "integer", "minimum": 0 },
    "generatorVersion": { "type": "string" },
    "events": { "type": "array", "maxItems": 16384, "items": { "type": "object" } }
  },
  "additionalProperties": false
}
